{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layerly.check.v0.5-draft",
  "title": "Layerly standalone extended-crawl report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "is_sample",
    "check_id",
    "status",
    "input",
    "created_at",
    "started_at",
    "finished_at",
    "expires_at",
    "limits",
    "coverage",
    "pages",
    "links",
    "findings",
    "evidence",
    "explanation",
    "errors",
    "request_log",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "layerly.check.v0.5-draft"
      ]
    },
    "is_sample": {
      "type": "boolean"
    },
    "sample_note": {
      "type": "string"
    },
    "check_id": {
      "type": "string",
      "pattern": "^chk_[a-z0-9_]{8,40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "normalized_url",
        "lang"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "normalized_url": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "hy"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pages",
        "max_requests",
        "max_dns_lookups",
        "request_timeout_ms",
        "job_timeout_ms",
        "max_body_bytes"
      ],
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "max_dns_lookups": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_ms": {
          "type": "integer"
        },
        "job_timeout_ms": {
          "type": "integer"
        },
        "max_body_bytes": {
          "type": "integer"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_host",
        "pages_selected",
        "pages_fetched",
        "pages_failed",
        "pages_skipped",
        "requests_used",
        "requests_limit",
        "dns_lookups_used",
        "dns_lookups_limit",
        "links_found",
        "links_checked",
        "links_not_checked",
        "links_not_checked_by_reason",
        "robots_txt",
        "robots_origins",
        "stopped_reason",
        "checks_not_run"
      ],
      "properties": {
        "site_host": {
          "type": [
            "string",
            "null"
          ]
        },
        "pages_selected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pages_fetched": {
          "type": "integer",
          "minimum": 0
        },
        "pages_failed": {
          "type": "integer",
          "minimum": 0
        },
        "pages_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "requests_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        },
        "requests_limit": {
          "type": "integer"
        },
        "dns_lookups_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "dns_lookups_limit": {
          "type": "integer"
        },
        "links_found": {
          "type": "integer",
          "minimum": 0
        },
        "links_checked": {
          "type": "integer",
          "minimum": 0
        },
        "links_not_checked": {
          "type": "integer",
          "minimum": 0
        },
        "links_not_checked_by_reason": {
          "type": "object"
        },
        "robots_txt": {
          "type": "string",
          "enum": [
            "fetched",
            "absent",
            "access_denied",
            "unknown",
            "not_fetched"
          ]
        },
        "robots_origins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "state",
              "http_status",
              "reason"
            ],
            "properties": {
              "origin": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "fetched",
                  "absent",
                  "access_denied",
                  "unknown",
                  "not_fetched"
                ]
              },
              "http_status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "stopped_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "request_budget_exhausted",
            "dns_budget_exhausted",
            "job_timeout",
            "page_limit_reached"
          ]
        },
        "checks_not_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_url",
              "reason"
            ],
            "properties": {
              "page_url": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "final_url",
          "fetch_status",
          "http_status",
          "redirect_chain",
          "content_type",
          "bytes",
          "fetch_ms",
          "error_code",
          "measured",
          "evidence_ids",
          "fetched_at",
          "body_sha256"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "final_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetch_status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "skipped"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "redirect_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "http_status",
                "location"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "http_status": {
                  "type": "integer"
                },
                "location": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fetch_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "measured": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[0-9a-f]{12}$"
            }
          },
          "fetched_at": {
            "type": "string"
          },
          "body_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "source_page",
          "method",
          "status",
          "http_status",
          "evidence_id",
          "reason"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "source_page": {
            "type": "string"
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "HEAD",
              "GET",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "broken",
              "redirect",
              "blocked",
              "error",
              "not_checked"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "rule_id",
          "page_url",
          "severity",
          "needs_context",
          "summary",
          "evidence_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^fd_[0-9]{2,}$"
          },
          "rule_id": {
            "type": "string"
          },
          "page_url": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "needs_context": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ev_[0-9a-f]{12}$"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "kind",
          "url",
          "locator",
          "excerpt",
          "http_status",
          "fetched_at",
          "body_sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "http_status",
              "http_redirect",
              "http_header",
              "html_element",
              "html_absent",
              "jsonld_parse_error",
              "robots_txt_rule",
              "robots_txt_status",
              "link_check",
              "text_stats"
            ]
          },
          "url": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 300
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "body_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "lang",
        "items",
        "reason",
        "is_test"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "disabled",
            "not_available",
            "refused",
            "budget_exhausted",
            "validation_failed",
            "error"
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "hy"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "refusal",
            "budget_exhausted",
            "ledger_halted",
            "invalid_json",
            "schema_invalid",
            "reference_invalid",
            "unsupported_claim",
            "unsafe_content",
            "provider_timeout",
            "provider_ambiguous",
            "provider_not_sent",
            "internal_error",
            "test_provider_on_real_report",
            "no_findings",
            "payload_too_large"
          ]
        },
        "is_test": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_ids",
              "evidence_ids",
              "text"
            ],
            "properties": {
              "finding_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "pattern": "^fd_[0-9]{2,}$"
                }
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "pattern": "^ev_[0-9a-f]{12}$"
                }
              },
              "text": {
                "type": "string",
                "maxLength": 600
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "url",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "request_log": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "purpose",
          "method",
          "url",
          "connect_ip",
          "result"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string",
            "enum": [
              "robots",
              "page",
              "redirect",
              "link",
              "retry"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD"
            ]
          },
          "url": {
            "type": "string"
          },
          "connect_ip": {
            "type": "string"
          },
          "result": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          }
        }
      }
    },
    "disclaimer": {
      "type": "string"
    }
  }
}
